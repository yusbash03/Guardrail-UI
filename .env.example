# The app always calls the API same-origin at /api/v1:
#   - dev/preview: Vite proxies /api to API_PROXY_TARGET (default http://localhost:5080)
#   - production:  vercel.json rewrites /api to https://guardrail-api-bxyn.onrender.com
VITE_API_BASE_URL=/api/v1
VITE_PAYPAL_ENV_LABEL=Sandbox

# Dev/preview proxy target (not bundled). `npm run dev:render` sets it to the Render API.
# API_PROXY_TARGET=https://guardrail-api-bxyn.onrender.com
